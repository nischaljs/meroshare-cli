{
  "name": "nepse-ipo",
  "version": "1.0.0",
  "description": "Bulk MeroShare IPO CLI tool for Nepal Stock Exchange",
  "type": "module",
  "bin": {
    "ipo": "./bin/ipo.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx bin/cli.ts",
    "start": "node dist/bin/cli.js",
    "ipo": "tsx bin/cli.ts",
    "test": "node --import tsx --test \"src/**/*.test.ts\" \"test/**/*.test.ts\"",
    "lint:deps": "depcruise src bin test --config .dependency-cruiser.cjs",
    "check": "tsc --noEmit && npm run lint:deps && npm test"
  },
  "keywords": [
    "nepse",
    "ipo",
    "meroshare",
    "cdsc",
    "nepal",
    "stock"
  ],
  "license": "MIT",
  "dependencies": {
    "@inquirer/prompts": "^7.0.0",
    "chalk": "^5.3.0",
    "cli-table3": "^0.6.5",
    "commander": "^12.1.0",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.16",
    "ora": "^8.1.1",
    "p-limit": "^6.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.17",
    "dependency-cruiser": "^17.4.3",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}

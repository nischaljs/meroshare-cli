{
  "name": "meroshare-cli",
  "version": "1.0.1",
  "description": "Apply for NEPSE IPOs on MeroShare from every family account with one command. Runs only on your computer: passwords stay encrypted on your device and go to MeroShare only.",
  "keywords": [
    "nepse",
    "ipo",
    "meroshare",
    "cdsc",
    "nepal",
    "stock"
  ],
  "homepage": "https://github.com/nischaljs/meroshare-cli#readme",
  "bugs": {
    "url": "https://github.com/nischaljs/meroshare-cli/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nischaljs/meroshare-cli.git"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^18.17.0 || >=20.5.0"
  },
  "bin": {
    "ipo": "dist/bin/cli.js",
    "meroshare-cli": "dist/bin/cli.js"
  },
  "files": [
    "dist/bin/**/*.js",
    "dist/src/**/*.js",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "dev": "tsx bin/cli.ts",
    "start": "node dist/bin/cli.js",
    "ipo": "tsx bin/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\" \"test/**/*.test.ts\"",
    "lint:deps": "depcruise src bin test --config .dependency-cruiser.cjs",
    "test:pack": "node scripts/test-pack.mjs",
    "check": "npm run typecheck && npm run lint:deps && npm test && npm run test:pack"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.0.0",
    "chalk": "^5.3.0",
    "cli-table3": "^0.6.5",
    "commander": "^12.1.0",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.16",
    "ora": "^8.1.1",
    "p-limit": "^6.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.17",
    "dependency-cruiser": "^17.4.3",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
